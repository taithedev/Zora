# Backend function/server only. NEVER ship database credentials in any EXE.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/zora?sslmode=require
ZORA_KEY_PEPPER=GENERATE_A_LONG_RANDOM_SECRET
ZORA_SESSION_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
ZORA_CLOUD_FUNCTION=1
# Password hashes and revocable owner session hashes live in Neon tables.
# Run `node scripts/setup-owner.mjs` once with DATABASE_URL to configure owner login.

# Connect the same Discord application as ZuzifyDiscordBot. Do not use a bot token here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match Discord Developer Portal OAuth2 Redirects exactly:
DISCORD_REDIRECT_URI=https://br-frosty-bar-bbmdnhr7-zoralicense.compute.c-15.us-east-1.aws.neon.tech/v1/discord/callback
# Random 32+ character token, shared ONLY between Neon and the bot host.
ZORA_BOT_SYNC_SECRET=

# Public Zuzify ID OAuth configuration (defaults are already built in).
ZUZIFY_AUTH_URL=https://ep-rough-recipe-bcjp6wq7.neonauth.c-16.us-east-1.aws.neon.tech/neondb/auth
ZUZIFY_OAUTH_CLIENT_ID=NKTcizNpNAplTPMSxWfSjVBIrxLHuApK
ZUZIFY_REDIRECT_URI=https://br-frosty-bar-bbmdnhr7-zoralicense.compute.c-15.us-east-1.aws.neon.tech/v1/zuzify/callback
