# Backend function/server only. NEVER ship database credentials in any EXE.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/zora?sslmode=require
ZORA_KEY_PEPPER=GENERATE_A_LONG_RANDOM_SECRET
ZORA_SESSION_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
ZORA_CLOUD_FUNCTION=1
# Password hashes and revocable owner session hashes live in Neon tables.
# Run `node scripts/setup-owner.mjs` once with DATABASE_URL to configure owner login.
