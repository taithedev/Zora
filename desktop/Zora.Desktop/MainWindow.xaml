<Window x:Class="Zora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Zora.Desktop.Views"
        Title="ZORA" Width="1460" Height="860" MinWidth="1050" MinHeight="670"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid Background="Black" ClipToBounds="True">
    <Grid x:Name="WorkspaceRoot" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#050505" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
          <Border Width="28" Height="28" CornerRadius="7" Background="White" Margin="0,0,12,0"><TextBlock Text="Z" Foreground="Black" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="ZORA" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="ASSET RECOVERY STUDIO" Foreground="{StaticResource SubText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Width="46" Height="56" Padding="0" Content="―" Background="Transparent" Click="Minimize_Click"/>
          <Button Width="46" Height="56" Padding="0" Content="□" FontSize="17" Background="Transparent" Click="Maximize_Click"/>
          <Button Width="46" Height="56" Padding="0" Content="×" FontSize="21" Background="Transparent" Click="Close_Click"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <Grid Margin="15,25,15,25">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="WORKSPACE" Foreground="{StaticResource SubText}" FontSize="10" FontWeight="SemiBold" Margin="15,0,0,18"/>
            <StackPanel Grid.Row="1">
              <Button Content="▣     Asset explorer" Style="{StaticResource SidebarButton}" Background="#222222" Click="Explorer_Click" Margin="0,0,0,5"/>
              <Button Content="◫     Open project" Style="{StaticResource SidebarButton}" Click="OpenProject_Click" Margin="0,0,0,5"/>
              <Button Content="▤     Open app / archive" Style="{StaticResource SidebarButton}" Click="OpenBuild_Click" Margin="0,0,0,5"/>
              <Button x:Name="RecoverButton" Content="↓     Recover project" Style="{StaticResource SidebarButton}" Click="RecoverProject_Click" Margin="0,0,0,5"/>
              <Button Content="⌘     Code studio" Style="{StaticResource SidebarButton}" Click="CodeStudio_Click" Margin="0,0,0,5"/>
              <Button Content="◆     Zuro · owner" Style="{StaticResource SidebarButton}" Click="Zuro_Click" Margin="0,0,0,5"/>
              <Button x:Name="CheckUpdatesButton" Content="↻     Check for updates" Style="{StaticResource SidebarButton}" Click="CheckUpdates_Click" Margin="0,0,0,5"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="14,10,8,0">
              <TextBlock Text="SIGNED IN" Foreground="{StaticResource SubText}" FontSize="10" Margin="0,0,0,8"/>
              <TextBlock x:Name="AccountLabel" Text="Not activated" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="ZORA  /  0.5.0" Foreground="#6E6E6E" FontSize="10" Margin="0,15,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="ExplorerBody" Grid.Column="1" Margin="33,32,30,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Your assets." FontSize="34" FontWeight="SemiBold"/>
              <TextBlock Text="Inspect Unity builds, Windows programs and Android packages." FontSize="12" Foreground="{StaticResource SubText}" Margin="0,9,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="LOCAL PROCESSING" Foreground="#B5B5B5" FontSize="10" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="1" Margin="0,0,0,19">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="17,13" Margin="0,0,8,0"><StackPanel><TextBlock Text="ASSETS INDEXED" Foreground="{StaticResource SubText}" FontSize="10"/><TextBlock x:Name="IndexedStat" Text="0" FontSize="23" Margin="0,6,0,0" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}" Padding="17,13" Margin="0,0,8,0"><StackPanel><TextBlock Text="INPUT" Foreground="{StaticResource SubText}" FontSize="10"/><TextBlock x:Name="SourceStat" Text="NONE" FontSize="23" Margin="0,6,0,0" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="17,13"><StackPanel><TextBlock Text="SESSION" Foreground="{StaticResource SubText}" FontSize="10"/><TextBlock x:Name="SessionStat" Text="ACTIVE" FontSize="23" Margin="0,6,0,0" FontWeight="SemiBold"/></StackPanel></Border>
          </Grid>
          <Grid Grid.Row="2" Margin="0,0,0,17">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,16">
              <Button Content="OPEN SOURCE" Style="{StaticResource AccentButton}" Click="OpenBuild_Click" Margin="0,0,8,0"/>
              <Button x:Name="ExportSelectedButton" Content="EXPORT SELECTED" Click="ExportSelected_Click" Margin="0,0,8,0"/>
              <Button x:Name="ExportAllButton" Content="EXPORT ALL" Click="ExportAll_Click" Margin="0,0,8,0"/>
              <Button Content="RECOVER UNITY PROJECT" Click="RecoverProject_Click"/>
            </WrapPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="Search_Changed" ToolTip="Search by name, type, and path" Margin="0,0,8,0"/>
              <ComboBox x:Name="TypeFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All assets"/><ComboBoxItem Content="Textures"/><ComboBoxItem Content="Meshes / models"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Scripts / data"/><ComboBoxItem Content="Other"/><ComboBoxItem Content="App resources"/><ComboBoxItem Content="PE sections"/>
              </ComboBox>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="SourceLabel" Text="Drop an EXE, APK, asset file, or project folder anywhere in Zora." FontSize="11" Foreground="{StaticResource SubText}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
          </Grid>
          <DataGrid Grid.Row="3" x:Name="AssetGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                    CanUserAddRows="False" EnableRowVirtualization="True" SelectionChanged="AssetGrid_SelectionChanged" MouseDoubleClick="AssetGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ASSET" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="*"/>
              <DataGridTextColumn Header="ORIGIN" Binding="{Binding Origin}" Width="*"/>
              <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="AssetCountText" Text="0 assets" FontSize="11" Foreground="{StaticResource SubText}"/>
              <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready" FontSize="11" Foreground="White" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <ProgressBar x:Name="WorkingBar" Grid.Row="1" Margin="0,10,0,0" Height="2" IsIndeterminate="True" Visibility="Collapsed"/>
          </Grid>
        </Grid>
        <Grid x:Name="InspectorBody" Grid.Column="2" Background="#080808" Margin="0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="INSPECTOR" Foreground="{StaticResource SubText}" FontSize="10" FontWeight="SemiBold" Margin="24,35,0,22"/>
          <Grid Grid.Row="1" Background="#111111" Margin="18,0,18,0" ClipToBounds="True">
            <TextBlock x:Name="NoPreviewText" Text="SELECT AN ASSET" Foreground="{StaticResource SubText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
          </Grid>
          <Button Grid.Row="2" Content="PREVIEW TEXTURE" Margin="18,12,18,25" Click="Preview_Click"/>
          <StackPanel Grid.Row="3" Margin="24,0,24,0">
            <TextBlock Text="ASSET DETAILS" Foreground="{StaticResource SubText}" FontSize="10" Margin="0,0,0,16"/>
            <TextBlock x:Name="DetailName" Text="Nothing selected" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="DetailType" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,15,0,0"/>
            <TextBlock x:Name="DetailOrigin" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,9,0,0"/>
            <TextBlock x:Name="DetailSize" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,9,0,0"/>
            <TextBlock x:Name="DetailSource" Foreground="{StaticResource SubText}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="4" Margin="24,12,24,26">
            <TextBlock Text="RECOVERY NOTES" Foreground="White" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="NoticeLabel" Text="Import an owned project or compiled game to begin. Recovered builds may not contain original C# source or editable scene graphs." Foreground="{StaticResource SubText}" FontSize="11"/>
          </StackPanel>
        </Grid>
        <views:CodeWorkbench x:Name="CodeStudioView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
        <views:ZuroPanel x:Name="ZuroView" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
      </Grid>
    </Grid>
    <!-- Activation is part of the same window. No secondary Windows dialog, endpoint field, or database credential. -->
    <Grid x:Name="ActivationOverlay" Background="Black">
      <StackPanel Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Border Background="White" Width="54" Height="54" CornerRadius="15" HorizontalAlignment="Center" Margin="0,0,0,38">
          <TextBlock Text="Z" FontWeight="Black" FontSize="35" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="ZORA" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,14"/>
        <StackPanel x:Name="KeyEntryPanel">
          <TextBlock Text="Enter license key." FontSize="31" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock Text="Your license is your account. No password or email." FontSize="12" Foreground="{StaticResource SubText}" TextAlignment="Center" Margin="0,0,0,29"/>
          <TextBox x:Name="LicenseKeyBox" TextAlignment="Center" MaxLength="34" Height="53" VerticalContentAlignment="Center" FontSize="15" CharacterCasing="Upper" KeyDown="LicenseKey_KeyDown"/>
          <Button x:Name="NextActivationButton" Style="{StaticResource AccentButton}" Content="CONTINUE" Height="50" Margin="0,12,0,0" Click="KeyNext_Click"/>
        </StackPanel>
        <StackPanel x:Name="UsernameEntryPanel" Visibility="Collapsed">
          <TextBlock Text="Choose a username." FontSize="31" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock Text="One username is permanently linked to this license." FontSize="12" Foreground="{StaticResource SubText}" TextAlignment="Center" Margin="0,0,0,29"/>
          <TextBox x:Name="UsernameBox" TextAlignment="Center" MaxLength="24" Height="53" VerticalContentAlignment="Center" KeyDown="Username_KeyDown"/>
          <Button x:Name="ActivateButton" Style="{StaticResource AccentButton}" Content="ACTIVATE ZORA" Height="50" Margin="0,12,0,0" Click="Activate_Click"/>
          <Button Content="BACK TO LICENSE KEY" Margin="0,8,0,0" Background="Transparent" Click="ActivationBack_Click"/>
        </StackPanel>
        <TextBlock x:Name="ActivationStatus" Foreground="White" FontSize="12" TextAlignment="Center" Margin="0,20,0,0"/>
        <TextBlock Text="ZORA  /  LICENSED SOFTWARE  /  $25" Foreground="#777777" FontSize="10" TextAlignment="Center" Margin="0,43,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
