<Window x:Class="Zora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zora — Unity Asset Workspace" Width="1380" Height="840" MinWidth="1070" MinHeight="640"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <Grid Background="{StaticResource Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="310"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="21,28,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource Primary}" Width="39" Height="39" CornerRadius="12" Margin="0,0,11,0">
            <TextBlock Text="Z" FontWeight="Black" FontSize="23" Foreground="#07111C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ZORA" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="ASSET WORKSPACE" FontSize="9" Foreground="{StaticResource SubText}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="WORKSPACE" FontSize="10" Foreground="{StaticResource SubText}" FontWeight="SemiBold" Margin="8,0,0,13"/>
          <Border Background="#1B2938" CornerRadius="10" Padding="13,12" Margin="0,0,0,8">
            <TextBlock Text="◈   Asset explorer" FontSize="14" Foreground="#D9EBFF" FontWeight="SemiBold"/>
          </Border>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="LOCAL PROCESSING" Foreground="{StaticResource Primary}" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="Your Unity files stay on this PC. Only license checks use the Zora API." Foreground="{StaticResource SubText}" FontSize="12" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="4">
          <TextBlock Text="LICENSE" Foreground="{StaticResource SubText}" FontSize="10" Margin="7,0,0,5"/>
          <TextBlock x:Name="AccountLabel" Text="Not activated" FontWeight="SemiBold" FontSize="13" Margin="7,0,0,11"/>
          <TextBlock Text="Zora Preview 0.1.0" Foreground="{StaticResource SubText}" FontSize="11" Margin="7,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="27,27,27,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,20">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Asset explorer" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="Inspect your own Unity projects and compiled builds." Foreground="{StaticResource SubText}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,16">
        <WrapPanel Margin="0,0,0,14">
          <Button Content="+  Open Unity project" Style="{StaticResource AccentButton}" Click="OpenProject_Click" Margin="0,0,9,0"/>
          <Button Content="Open game / asset file" Click="OpenBuild_Click" Margin="0,0,9,0"/>
          <Button x:Name="ExportSelectedButton" Content="Export selected" Click="ExportSelected_Click" Margin="0,0,9,0"/>
          <Button x:Name="ExportAllButton" Content="Export all" Click="ExportAll_Click"/>
        </WrapPanel>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10">
          <DockPanel>
            <ComboBox x:Name="TypeFilter" DockPanel.Dock="Right" Width="150" Margin="9,0,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
              <ComboBoxItem Content="All types"/>
              <ComboBoxItem Content="Textures"/>
              <ComboBoxItem Content="Models / meshes"/>
              <ComboBoxItem Content="Audio"/>
              <ComboBoxItem Content="Text / scripts"/>
              <ComboBoxItem Content="Other"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Background="#0C1013" BorderThickness="0" Foreground="{StaticResource Text}" ToolTip="Filter by name, type, or file path"/>
          </DockPanel>
        </Border>
        <TextBlock x:Name="SourceLabel" Text="No source loaded. Choose a Unity project, game EXE, APK, or asset file." Foreground="{StaticResource SubText}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="2,10,0,0"/>
      </StackPanel>
      <Border Grid.Row="2" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <DataGrid x:Name="AssetGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserAddRows="False" SelectionChanged="AssetGrid_SelectionChanged" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ASSET" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="*"/>
            <DataGridTextColumn Header="ORIGIN" Binding="{Binding Origin}" Width="*"/>
            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <DockPanel Grid.Row="3" Margin="0,14,0,0">
        <TextBlock x:Name="AssetCountText" Text="0 assets indexed" Foreground="{StaticResource SubText}" FontSize="12" DockPanel.Dock="Left"/>
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Primary}" HorizontalAlignment="Right" FontSize="12"/>
      </DockPanel>
    </Grid>
    <Border Grid.Column="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <Grid Margin="22,29,22,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="INSPECTOR" Grid.Row="0" Foreground="{StaticResource SubText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,17"/>
        <Border Grid.Row="1" Background="#13171B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="8">
          <Grid>
            <TextBlock x:Name="NoPreviewText" Text="Select an asset to inspect" Foreground="{StaticResource SubText}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Button Grid.Row="2" Content="Preview selected texture" Margin="0,13,0,18" Click="Preview_Click"/>
        <StackPanel Grid.Row="3">
          <TextBlock Text="DETAILS" Foreground="{StaticResource SubText}" FontSize="10" FontWeight="Bold" Margin="0,0,0,15"/>
          <TextBlock x:Name="DetailName" FontWeight="SemiBold" FontSize="18" Text="No selection" TextWrapping="Wrap"/>
          <TextBlock x:Name="DetailType" Foreground="{StaticResource Primary}" Margin="0,11,0,0" FontSize="12"/>
          <TextBlock x:Name="DetailOrigin" Foreground="{StaticResource SubText}" Margin="0,11,0,0" FontSize="12"/>
          <TextBlock x:Name="DetailSize" Foreground="{StaticResource SubText}" Margin="0,11,0,0" FontSize="12"/>
          <TextBlock x:Name="DetailSource" Foreground="{StaticResource SubText}" Margin="0,11,0,0" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Text="Zora handles authorized content. Encrypted and unsupported Unity objects may not be exportable." Grid.Row="4" Foreground="{StaticResource SubText}" FontSize="11"/>
      </Grid>
    </Border>
  </Grid>
</Window>
