<Window x:Class="Zora.Desktop.LicenseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Activate Zora" Width="470" Height="530"
        MinWidth="470" MinHeight="530" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Border Background="{StaticResource Canvas}" Padding="36,27">
    <StackPanel>
      <Border Background="{StaticResource Primary}" Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left">
        <TextBlock Text="Z" FontWeight="Black" FontSize="32" Foreground="#07111C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Activate Zora" FontSize="27" FontWeight="SemiBold" Margin="0,18,0,5"/>
      <TextBlock Text="A license key is your account. No email or password required." FontSize="12" Foreground="{StaticResource SubText}" Margin="0,0,0,20"/>
      <TextBlock Text="USERNAME" FontSize="10" Foreground="{StaticResource SubText}" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBox x:Name="UsernameBox" MaxLength="24" Margin="0,0,0,17"/>
      <TextBlock Text="LICENSE KEY" FontSize="10" Foreground="{StaticResource SubText}" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBox x:Name="KeyBox" MaxLength="100" Margin="0,0,0,16"/>
      <TextBlock Text="LICENSE SERVER" FontSize="10" Foreground="{StaticResource SubText}" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBox x:Name="ApiBox" Margin="0,0,0,20"/>
      <Button x:Name="ActivateButton" Style="{StaticResource AccentButton}" Content="Activate license" Click="Activate_Click" Height="44"/>
      <TextBlock x:Name="ErrorLabel" Foreground="#FF9B99" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="Requires an active license and an internet connection to validate. License keys are not sent to the asset extraction engine." FontSize="11" Foreground="{StaticResource SubText}" Margin="0,12,0,0"/>
    </StackPanel>
  </Border>
</Window>
