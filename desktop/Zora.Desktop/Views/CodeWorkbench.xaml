<UserControl x:Class="Zora.Desktop.Views.CodeWorkbench"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black" Foreground="White">
  <Grid Margin="30,24,30,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Code studio." FontSize="32" FontWeight="SemiBold"/>
        <TextBlock Text="Edit authorized project files with intelligent Tab suggestions." Foreground="{StaticResource SubText}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="LOCAL EDITING · CTRL+SPACE FOR COMPLETION" FontSize="10" Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
    </Grid>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14">
      <Button Style="{StaticResource AccentButton}" Content="NEW  CTRL+N" Click="New_Click" Margin="0,0,8,0"/>
      <Button Content="OPEN  CTRL+O" Click="Open_Click" Margin="0,0,8,0"/>
      <Button Content="SAVE  CTRL+S" Click="Save_Click" Margin="0,0,8,0"/>
      <Button Content="SAVE AS" Click="SaveAs_Click" Margin="0,0,8,0"/>
      <Button Content="CLOSE TAB" Click="Close_Click" Margin="0,0,8,0"/>
      <TextBox x:Name="FindTextBox" Width="155" Height="40" VerticalContentAlignment="Center" Margin="0,0,7,0" ToolTip="Find text" KeyDown="FindText_KeyDown"/>
      <Button Content="FIND NEXT" Click="Find_Click" Margin="0,0,8,0"/>
      <TextBox x:Name="GoLineBox" Width="57" Height="40" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,7,0" ToolTip="Line number" KeyDown="GoLineText_KeyDown"/>
      <Button Content="GO" Click="GoLine_Click"/>
    </WrapPanel>
    <Border Grid.Row="2" CornerRadius="14" Background="#080808" ClipToBounds="True">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TabControl x:Name="Documents" Grid.RowSpan="2" Background="#080808" BorderThickness="0" SelectionChanged="Documents_SelectionChanged"/>
        <Grid x:Name="EmptyState" Grid.RowSpan="2" Background="#080808">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="38" HorizontalAlignment="Center" Foreground="#747474"/>
            <TextBlock Text="Open a file to begin." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="C#, Lua, JSON, XML, Python, shaders and other text sources." Foreground="{StaticResource SubText}" Margin="0,8,0,0"/>
            <Button Content="OPEN SOURCE FILE" Style="{StaticResource AccentButton}" Margin="0,22,0,0" Click="Open_Click"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="4,13,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="EditorStatus" Foreground="{StaticResource SubText}" FontSize="11" Text="No file open"/>
      <TextBlock Grid.Column="1" Foreground="{StaticResource SubText}" FontSize="11" Text="TAB: COMPLETE / INDENT     CTRL+D: DUPLICATE LINE"/>
    </Grid>
  </Grid>
</UserControl>
