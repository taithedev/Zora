<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Zora</AssemblyName>
    <RootNamespace>Zora.Desktop</RootNamespace>
    <Version>0.7.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Views/Monochrome.xshd" />
    <Compile Include="../../shared/UpdateService.cs" Link="Services/UpdateService.cs" />
  </ItemGroup>
</Project>
